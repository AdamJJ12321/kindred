rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /stories/{storyId}/evidence/{fileName} {
      allow read, write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/stories/$(storyId)).data.creatorId == request.auth.uid;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
