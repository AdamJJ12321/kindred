rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function ownsStory() { return signedIn() && resource.data.creatorId == request.auth.uid; }
    function ownsParentStory(storyId) { return signedIn() && get(/databases/$(database)/documents/stories/$(storyId)).data.creatorId == request.auth.uid; }
    // Separate allow paths so Explore list queries on public+published stay valid.
    function isOwner() {
      return signedIn() && resource.data.creatorId == request.auth.uid;
    }
    function isPublicPublished() {
      return resource.data.status == 'published'
        && resource.data.visibility == 'public';
    }
    function isFamilyReadable() {
      return signedIn()
        && resource.data.status == 'published'
        && (resource.data.visibility == 'private'
          || resource.data.visibility == 'family')
        && resource.data.keys().hasAny(['familyMemberIds'])
        && resource.data.familyMemberIds.hasAny([request.auth.uid]);
    }
    function isInvitedReadable() {
      return signedIn()
        && resource.data.status == 'published'
        && resource.data.visibility == 'invited'
        && resource.data.keys().hasAny(['allowedUserIds'])
        && resource.data.allowedUserIds.hasAny([request.auth.uid]);
    }
    function storyIsReadable(story) {
      return (signedIn() && story.data.creatorId == request.auth.uid)
        || (story.data.status == 'published' && story.data.visibility == 'public')
        || (signedIn()
          && story.data.status == 'published'
          && (story.data.visibility == 'private' || story.data.visibility == 'family')
          && story.data.keys().hasAny(['familyMemberIds'])
          && story.data.familyMemberIds.hasAny([request.auth.uid]))
        || (signedIn()
          && story.data.status == 'published'
          && story.data.visibility == 'invited'
          && story.data.keys().hasAny(['allowedUserIds'])
          && story.data.allowedUserIds.hasAny([request.auth.uid]));
    }
    function canReadStory() {
      return isOwner() || isPublicPublished() || isFamilyReadable()
        || isInvitedReadable();
    }
    function isFamilyMember(familyId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.status == 'active';
    }

    match /stories/{storyId} {
      allow read: if canReadStory();
      allow create: if signedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if ownsStory() && request.resource.data.creatorId == resource.data.creatorId;
      allow delete: if ownsStory();

      match /evidence/{evidenceId} {
        allow read: if storyIsReadable(get(/databases/$(database)/documents/stories/$(storyId)));
        allow create: if ownsParentStory(storyId) && request.resource.data.uploadedBy == request.auth.uid;
        allow update: if ownsParentStory(storyId) && request.resource.data.uploadedBy == resource.data.uploadedBy;
        allow delete: if ownsParentStory(storyId);
      }
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /families/{familyId} {
      allow read: if resource.data.visibility == 'public';
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      match /members/{memberId} {
        allow read: if signedIn() && (request.auth.uid == memberId ||
          get(/databases/$(database)/documents/families/$(familyId)).data.ownerId == request.auth.uid);
        allow write: if signedIn() && get(/databases/$(database)/documents/families/$(familyId)).data.ownerId == request.auth.uid;
      }
    }

    match /dailyQuestions/{questionId} {
      allow read: if true;
      allow write: if false;
    }

    match /timelineEvents/{eventId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
